// Подключаем заголовочные файлы IntroSatLib.
#include "IntroSatLib.h"
#include <Device/ISLIRReceiver/ISLIRReceiver.h>  // Подключаем заголовочный файл класса ИК-приёмника

using namespace IntroSatLib;       // Пространство имён, чтобы не писать IntroSatLib::

// Создаём объект ИК-приёмника, подключённого к пину PD2 (INT0 на Arduino Uno).
// Только приём, передача отсутствует.
ISLIRReceiver receiver(PD2);

// Буфер для принятых данных, до 64 байт.
uint8_t buff[64];

// Обработчик прерывания от ИК-приёмника.
// Вызывается при изменении уровня на пине PD2.
// Передаёт управление методу ProcessReceiving() для сбора пакета.
void receiveISR()
{
  uint8_t oldSREG = SREG;       // Сохранение значения регистра состояния
  cli();                        // Отключение прерываний
  receiver.ProcessReceiving();  // Прием данных
  SREG = oldSREG;               // Восстановление значения регистра состояния
}

void setup() 
{
  // Инициализация последовательного порта для вывода информации (115200 бод).
  Serial.begin(115200);

  // Инициализация ИК-приёмника.
  receiver.Init();
  delay(1000);   // Пауза после инициализации

  // Привязываем прерывание INT0 (пин 2) к функции receive.
  // CHANGE – прерывание по любому изменению сигнала (фронт/спад).
  attachInterrupt(0, receiveISR, CHANGE);
}

void loop() 
{
  // --------------------------- ПРИЁМ ---------------------------
  // Если ИК-приёмник получил и декодировал пакет данных.
  if (receiver.Available())
  {
    // Забираем данные в буфер, не более 64 байт. n – сколько реально получено.
    uint16_t n = receiver.GetData(buff, 64);

    // Выводим количество байт и сами данные в монитор порта.
    Serial.print("Data ");
    Serial.print(n);
    Serial.print(": ");
    for (int i = 0; i < n; i++)
    {
      // Печатаем каждый байт как символ (если это текст) и пробел.
      Serial.print((char)buff[i]);
      Serial.print(" ");
    }
    Serial.println();
  }

  // Пауза 1 секунда, чтобы не нагружать процессор непрерывным опросом.
  delay(1000);
}