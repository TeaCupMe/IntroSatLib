@PACKAGE_INIT@

set(IntroSatLib_BACKEND "@INTROSATLIB_BACKEND@")
set(IntroSatLib_PLATFORM_TARGET "@INTROSATLIB_PLATFORM_TARGET@")

if(NOT TARGET "${IntroSatLib_PLATFORM_TARGET}")
	set(IntroSatLib_FOUND FALSE)
	set(
		IntroSatLib_NOT_FOUND_MESSAGE
		"IntroSatLib was built with the ${IntroSatLib_BACKEND} backend and "
		"requires platform target '${IntroSatLib_PLATFORM_TARGET}'. "
		"Create that target before calling find_package(IntroSatLib)."
	)
	return()
endif()

if(NOT TARGET IntroSatLib::Platform)
	add_library(IntroSatLib::Platform INTERFACE IMPORTED)
endif()
set_property(
	TARGET IntroSatLib::Platform
	PROPERTY INTERFACE_LINK_LIBRARIES "${IntroSatLib_PLATFORM_TARGET}"
)

include("${CMAKE_CURRENT_LIST_DIR}/IntroSatLibTargets.cmake")
check_required_components(IntroSatLib)
